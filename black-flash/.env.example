# BLACK FLASH works fully without any of these (Local First mode). Fill them in on your host
# (e.g. Vercel → Project → Settings → Environment Variables) to enable the optional features.
# Never commit real values.

# --- Cloud sign-in + sync (Supabase). The anon key is designed to be public; protection comes from
# row-level security + the database allowlist (supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: comma-separated emails allowed to use server features (AI coach, push). Fails closed if empty.
ALLOWED_EMAILS=

# --- Optional AI coach (server-side only). Requires sign-in on a deployed app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # default: claude-opus-5-5
COACH_DEV_LOCALHOST=false   # "true" lets `npm run dev` on localhost use the coach without signing in

# --- Optional reminders when the app is closed (Web Push). Generate keys with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server-only. Lets the reminder job read reminder times. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret your scheduler sends as "Authorization: Bearer <CRON_SECRET>" to /api/push/dispatch.
CRON_SECRET=
