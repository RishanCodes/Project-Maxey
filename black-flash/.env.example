# BLACK FLASH works fully without any of these. Copy to .env.local only if you want the optional live AI Coach.
# Never commit real values. These are read on the server only; none use the NEXT_PUBLIC_ prefix.

# Server-side Anthropic API key for the optional AI Coach.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ANTHROPIC_MODEL=
# Live AI is refused on any non-localhost request unless real authentication exists.
# This build has no authentication, so live AI only runs in `next dev` on localhost when this is "true".
COACH_DEV_LOCALHOST=false

# Optional cloud sync (Supabase) is NOT implemented in this build. Reserved names:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
